# ==========================================
# BASE DE DONNÉES (PostgreSQL - Neon / Vercel Postgres ou SQLite en local)
# ==========================================
# En local :
DATABASE_URL="file:./dev.db"

# En production avec Neon / Supabase :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ==========================================
# SÉCURITÉ & AUTHENTIFICATION
# ==========================================
# Clé secrète de chiffrement (générer avec: openssl rand -base64 32)
AUTH_SECRET="presence_bureau_secret_key_super_secure_12345"

# URL publique de l'application
NEXTAUTH_URL="http://localhost:3000"

# Politique d'inscription : "false" pour restreindre l'inscription aux invitations uniquement (recommandé)
# ou "true" pour permettre l'inscription publique avec vérification d'email
ALLOW_PUBLIC_REGISTRATION="false"

# ==========================================
# ENVOI DE COURRIELS (Resend)
# ==========================================
# Fournisseur : Resend (https://resend.com)
# 1. Obtenez une clé API sur https://resend.com/api-keys
# 2. IMPORTANT : Par défaut, "onboarding@resend.dev" n'autorise l'envoi QUE vers
#    l'adresse email du titulaire du compte Resend (votre adresse personnelle).
# 3. Pour envoyer des courriels à tous les membres et collègues :
#    - Ajoutez et validez votre propre domaine sur https://resend.com/domains
#    - Définissez EMAIL_FROM avec une adresse de ce domaine vérifié (ex: notifications@mondomaine.com)
#
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="Présence Bureau <notifications@presence-bureau.fyi>"

# ==========================================
# NOTIFICATIONS PUSH (VAPID)
# ==========================================
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="VOTRE_CLE_PUBLIQUE_VAPID"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="VOTRE_CLE_PUBLIQUE_VAPID"
VAPID_PRIVATE_KEY="VOTRE_CLE_PRIVEE_VAPID"
VAPID_SUBJECT="mailto:admin@votredomaine.com"

# Jeton secret pour sécuriser l'exécution des tâches CRON (Vercel Cron)
CRON_SECRET="changez_ce_secret_pour_la_production"
